OPENROUTER_API_KEY=<provider-key>
BOABOT_DSN=postgresql://boa:boa@127.0.0.1:5433/boa
BOABOT_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Behavior-changing flags. Explicit process variables override these values.
# These match the deployed configuration. Running with any of them at 0
# changes routing and abstain behaviour — a replay against a partially
# flagged server will not reproduce production results.
BOABOT_COMPARISON_STRUCTURED=1
BOABOT_LLM_ROUTER=1
BOABOT_LLM_ANSWERABILITY=1
BOABOT_DEBUG=0
BOABOT_VOICE_BRIDGE_KEY=<random-shared-secret>
DEEPSEEK_API_KEY=<provider-key>
AZURE_SPEECH_KEY=.*********************************
AZURE_SPEECH_REGION=switzerlandnorth
AZURE_TTS_VOICE=sq-AL-AnilaNeural
VOICE_CONFIDENCE_GATE_DISABLED=1
GOOGLE_CLOUD_PROJECT=.*********************************
GOOGLE_SPEECH_REGION=eu
GOOGLE_CHIRP_MODEL=chirp_3
# GOOGLE_CLOUD_SPEECH_KEY=<AIza key, disabled: 403 on Gemini API - key belongs to a project without the Generative Language API>
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
GEMINI_API_KEY=AQ.*********************************
